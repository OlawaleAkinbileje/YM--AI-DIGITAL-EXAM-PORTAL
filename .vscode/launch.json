            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": true,
            "env": {
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            }
        }
    ]
}

